<odoo>
    <record id="amb_studio_inherit_view_picking_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="name">stock.picking.form.studio</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_done']" position="attributes">
                <attribute name="readonly">not company_id</attribute>
            </xpath>
            <xpath expr="//field[@name='external_ref']" position="attributes">
                <attribute name="string">Réf Livraison</attribute>
            </xpath>
        </field>
    </record>
    <record id="amb_studio_inherit_view_stock_move_line_detailed_operation_tree" model="ir.ui.view">
        <field name="model">stock.move.line</field>
        <field name="name">stock.move.line.operations.tree.studio</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="oci_description_achat" string="Description achat"/>
            </field>
        </field>
    </record>
    <record id="amb_studio_inherit_view_picking_internal_search" model="ir.ui.view">
        <field name="name">amb.studio.inherit.view.picking.internal.search</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='activities_exception']" position="after">
                <separator name="studio_separator_FY61S"/>
                <!-- not studio_filter_XCuGB                -->
<!--                <filter domain="[['invoice_ids','=',False]]" name="studio_filter_XCuGB"-->
<!--                        string="Non facturé"/>-->
            </xpath>
            <xpath expr="//filter[@name='picking_type']" position="after">
                <filter context="{'group_by': 'date'}" name="studio_group_by_eDy4G" string="Creation Date"/>
            </xpath>
        </field>
    </record>
</odoo>
