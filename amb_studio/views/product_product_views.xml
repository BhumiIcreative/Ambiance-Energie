<odoo>
    <!-- Tree View -->
    <record id="amb_studio_inherit_product_product_tree_view" model="ir.ui.view">
        <field name="name">product.product.tree.studio</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_id']" position="replace"/>
            <xpath expr="//field[@name='standard_price']" position="replace"/>
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="rf_fournisseur"/>
            </xpath>
            <xpath expr="//tree[1]/field[@name='name']" position="after">
                <field name="property_account_expense_id" optional="hide"/>
                <field name="property_account_income_id" optional="hide"/>
            </xpath>
        </field>
    </record>
    <!-- Form View -->
    <record id="amb_studio_inherit_product_view_form_normal" model="ir.ui.view">
        <field name="name">product.product.view.form.normal.studio</field>
        <field name="model">product.product</field>
        <field name="priority">4</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_po_id']" position="after">
                <field name="non_remisable_1"/>
            </xpath>
            <xpath expr="//field[@name='taxes_id']" position="after">
                <field name="dernier_prix_dachat_fournisseur" widget="monetary"/>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='general_information']/group[1]/group[@name='group_standard_price']/field[@name='company_id']"
                   position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='seller_ids']" position="inside">
                <form string="Supplier Information">
                    <group name="supplier_information">
                        <group name="vendor" string="Supplier">
                            <field name="product_variant_count" invisible="1"/>
                            <field name="partner_id" context="{'res_partner_search_mode': 'supplier'}"/>
                            <field name="product_name"/>
                            <field name="product_code"/>
                            <field name="product_id" groups="product.group_product_variant"
                                   domain="[('product_tmpl_id', '=', product_tmpl_id)]"
                                   options="{'no_create_edit': True}"/>
                            <label for="delay"/>
                            <div name="div_c5d41a">
                                <field name="delay" class="oe_inline"/>
                                days
                            </div>
                        </group>
                        <group string="Price list" name="group_6b77e1">
                            <field name="product_tmpl_id" string="Article"
                                   invisible="context.get('visible_product_tmpl_id', True)"/>
                            <label for="min_qty"/>
                            <div class="o_row" name="div_83e5f1">
                                <field name="min_qty"/>
                                <field name="product_uom" groups="uom.group_uom"/>
                            </div>
                            <label for="price"/>
                            <div class="o_row" name="div_e1e0eb">
                                <field name="price"/>
                                <field name="currency_id" groups="base.group_multi_currency"/>
                            </div>
                            <label for="date_start" string="Validity"/>
                            <div class="o_row" name="div_40c3b3">
                                <field name="date_start"/>
                                to
                                <field name="date_end"/>
                            </div>
                        </group>
                        <group string="Other information" name="group_7bad87">
                            <field name="company_id" options="{'no_create': True}" invisible="not company_id"/>
                        </group>
                    </group>
                </form>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/notebook[1]" position="inside">
                <page name="page_rUkF5" string="Current orders">
                    <group name="group_rUkF5">
                        <field name="commandes_en_cours_ids">
                            <tree decoration-muted="state == 'cancel'"
                                  default_order="date_deadline, picking_id, sequence" string="Moves" create="0"
                                  colspan="2">
                                <field name="date_deadline" widget="date" readonly="state in ['done']"
                                       column_invisible="1"/>
                                <field name="date" string="Creation date" widget="date" optional="hide"/>
                                <field name="picking_id" string="Reference" column_invisible="1"/>
                                <field name="sequence" column_invisible="1"/>
<!--&lt;!&ndash;                                <field name="point_de_vente_1"/>&ndash;&gt;stock move-->
                                <field name="origin" optional="show" string="Order reference"/>
<!--                                <field name="client_1" string="Client"/>tock move-->
                                <field name="product_id" readonly="state in ['done']" column_invisible="1"/>
                                <field name="product_uom_qty" string="Order in progress" sum="Sum of Initial Request"/>
                                <field name="product_uom" options="{'no_open': True, 'no_create': True}"
                                       string="Unit of measurement" groups="uom.group_uom" column_invisible="1"/>
                                <field name="location_id" options="{'no_create': True}" column_invisible="1"/>
                                <field name="location_dest_id" column_invisible="1"/>
                                <field name="create_date" column_invisible="1"/>
                                <field name="state" optional="show" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <!-- Kanban View -->
    <record id="amb_studio_inherit_product_kanban_view" model="ir.ui.view">
        <field name="name">product.product.kanban.expense</field>
        <field name="inherit_id" ref="product.product_kanban_view"/>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='product_lst_price']/field[@name='lst_price']" position="attributes">
                <attribute name="widget">monetary</attribute>
            </xpath>
            <xpath expr="//div[@name='product_lst_price']/field[@name='lst_price']" position="after">
                Qté:
                <field name="qty_available"/>
            </xpath>
        </field>
    </record>
    <!-- Search View -->
    <record id="amb_studio_inherit_mrp_product_product_search_view" model="ir.ui.view">
        <field name="name">mrp.product.product.search.studio</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="mrp.mrp_product_product_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search[1]/field[@name='name']" position="before">
                <field name="seller_ids"/>
            </xpath>
            <xpath expr="//field[@name='warehouse_id']" position="after">
                <field name="default_code"/>
            </xpath>
        </field>
    </record>
    <!-- Pivot View -->
    <record id="product_pivot_view" model="ir.ui.view">
        <field name="name">product.product.pivot</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <pivot string="Article"/>
        </field>
    </record>
    <!-- Action -->
    <record id="action_studio_article_product" model="ir.actions.act_window">
        <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                        This is your new action ; by default, it contains a list view and a form view.
                    </p>
                    <p>
                        You can start customizing these screens by clicking on the Studio icon on the
                        top right corner (you can also customize this help message there).
                    </p>
                ]]></field>
        <field name="name">Article</field>
        <field name="res_model">product.product</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>