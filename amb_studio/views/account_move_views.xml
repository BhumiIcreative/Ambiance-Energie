<odoo>
    <!-- Inherit Tree view  -->
    <record id="amb_studio_inherit_view_invoice_tree" model="ir.ui.view">
        <field name="name">amb.studio.inherit.view.invoice.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='ref']" position="after">
                <field name="invoice_user_id"/>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="amount_untaxed_signed" sum="Sum of Untaxed Amount Signed" string="HT"/>
                <field name="amount_tax_signed" sum="Sum of Tax Signed" string="TVA"/>
            </xpath>
            <xpath expr="//field[@name='amount_total_signed']" position="attributes">
                <attribute name="string">TTC</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

        </field>
    </record>
    <!-- Inherit Form view  -->
    <record id="amb_studio_inherit_view_move_form" model="ir.ui.view">
        <field name="name">account.move.inherit.view.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']"
                   position="attributes">
                <attribute name="required">True</attribute>
            </xpath>
        </field>
    </record>
    <!-- Inherit Filter view  -->
    <record id="amb_studio_inherit_view_account_invoice_filter" model="ir.ui.view">
        <field name="name">amb.studio.inherit.view.account.invoice.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search[1]/group[1]/separator[1]" position="after">
                <separator name="studio_separator_b8MRW"/>
                <filter domain="[['partner_id.type_produit_contact_ids.name','=','REVENDEUR']]"
                        name="studio_filter_8qfsS" string="Revendeur"/>
            </xpath>
            <xpath expr="//filter[@name='duedate']" position="after">
                <filter context="{'group_by': 'move_type'}" name="studio_group_by_UNNQD" string="Type (facture/avoir)"/>
                <filter context="{'group_by': 'partner_id'}" name="studio_group_by_0U8lp" string="Partner"/>
            </xpath>
        </field>
    </record>
    <!-- Factures impayées Action  -->
    <record id="action_studio_factures_impayees" model="ir.actions.act_window">
        <field name="context">{'default_move_type': 'in_invoice'}</field>
        <field name="domain">['&amp;','&amp;',('move_type', '=',
            'in_invoice'),('amount_residual_signed','!=',0),('state','=','posted')]
        </field>
        <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                Créer une facture client
              </p><p>
                Créez des factures, enregistrez des paiements et gardez une trace de vos discussions avec vos clients.
              </p>
            ]]></field>
        <field name="name">Factures impayées</field>
        <field name="res_model">account.move</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="account.view_invoice_tree"/>
        <field name="view_mode">tree,kanban,form</field>
    </record>
    <!-- Factures (toutes) Action    -->
    <record id="action_studio_factures_toutes" model="ir.actions.act_window">
        <field name="context">{'default_type': 'out_invoice'}</field>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                Créer une facture client
              </p><p>
                Créez des factures, enregistrez des paiements et gardez une trace de vos discussions avec vos clients.
              </p>
            ]]></field>
        <field name="name">Factures (toutes)</field>
        <field name="res_model">account.move</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="account.view_invoice_tree"/>
        <field name="view_mode">tree,kanban,form</field>
    </record>
    <!-- Générer encaissement Action  -->
    <record id="action_studio_generer_encaissement" model="ir.actions.act_window">
        <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                        This is your new action ; by default, it contains a list view and a form view.
                    </p>
                    <p>
                        You can start customizing these screens by clicking on the Studio icon on the
                        top right corner (you can also customize this help message there).
                    </p>
                ]]></field>
        <field name="name">Générer encaissement</field>
        <field name="res_model">account.move</field>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
    </record>
    <!-- Journal des ventes Action -->
    <record id="action_studio_journal_des_ventes" model="ir.actions.act_window">
        <field name="context">{'default_type': 'out_invoice'}</field>
        <field name="domain">['&amp;',('move_type', '=', 'out_invoice'),('state','=','posted')]</field>
        <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                        This is your new action ; by default, it contains a list view and a form view.
                    </p>
                    <p>
                        You can start customizing these screens by clicking on the Studio icon on the
                        top right corner (you can also customize this help message there).
                    </p>
                ]]></field>
        <field name="name">Journal des ventes</field>
        <field name="res_model">account.move</field>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
    </record>
    <!-- Avoirs Action  -->
    <record id="action_studio_avoirs" model="ir.actions.act_window">
        <field name="context">{'default_type': 'in_refund'}</field>
        <field name="domain">[('move_type', '=', 'in_refund')]</field>
        <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                Créer une note de crédit vendeur
              </p><p>
                Note that the easiest way to create a vendor credit note it to do it directly from the vendor bill.
              </p>]]></field>
        <field name="name">Avoirs</field>
        <field name="res_model">account.move</field>
        <field name="search_view_id" ref="account_3way_match.account_invoice_filter_inherit_account_3way_match"/>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="account.view_invoice_tree"/>
        <field name="view_mode">tree,kanban,form</field>
    </record>
    <!-- Factures impayées clt Action  -->
    <record id="action_studio_factures" model="ir.actions.act_window">
        <field name="context">{'default_type': 'out_invoice'}</field>
        <field name="domain">['&amp;','&amp;',('move_type', '=',
            'out_invoice'),('amount_residual_signed','!=',0),('state','=','posted')]
        </field>
        <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                Créer une facture client
              </p><p>
                Créez des factures, enregistrez des paiements et gardez une trace de vos discussions avec vos clients.
              </p>]]></field>
        <field name="limit">99999</field>
        <field name="name">Factures impayées clt</field>
        <field name="res_model">account.move</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="account.view_invoice_tree"/>
        <field name="view_mode">tree,kanban,form</field>
    </record>
    <!-- Action -->
    <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
        <field name="name">Bills</field>
        <field name="res_model">account.move</field>
        <field name="search_view_id" ref="account_3way_match.account_invoice_filter_inherit_account_3way_match"/>
        <field name="type">ir.actions.act_window</field>
    </record>
</odoo>