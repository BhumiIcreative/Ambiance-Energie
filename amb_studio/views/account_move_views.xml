    <record id="amb_studio_inherit_view_move_line_tree_grouped_general" model="ir.ui.view">
        <field name="name">account.consolidation.move.line.tree.studio</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree_grouped_general"/>
        <field name="arch" type="xml">
            <xpath expr="//tree[1]/field[@name='name']" position="after">
              <field name="quantity"/>
            </xpath>
            <xpath expr="//field[@name='credit']" position="after">
              <field name="balance" sum="Sum of Balance"/>
            </xpath>
        </field>
    </record>
</odoo>