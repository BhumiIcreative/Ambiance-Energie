<odoo>
    <record id="amb_studio_inherit_product_category_list_view" model="ir.ui.view">
        <field name="name">product.category.list.studio</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
