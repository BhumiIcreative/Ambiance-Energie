<odoo>
    <record id="view_batch_payment_tree" model="ir.ui.view">
        <field name="name">account.batch.payment.tree</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="sum">Sum of Amount</attribute>
            </xpath>
        </field>
    </record>

    <record id="amb_studio_inherit_view_batch_payment_form" model="ir.ui.view">
            <field name="name">bacs.account.batch.payment.form.studio</field>
            <field name="model">account.batch.payment</field>
            <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form[1]/sheet[1]/group[1]/group[2]/field[@name='name']" position="attributes">
                  <attribute name="readonly">not id</attribute>
                </xpath>
                <xpath expr="//form[1]/sheet[1]/notebook[1]/page[1]/field[@name='payment_ids']/tree[1]/field[@name='state']" position="attributes">
                  <attribute name="invisible"/>
                </xpath>
            </field>
        </record>
</odoo>