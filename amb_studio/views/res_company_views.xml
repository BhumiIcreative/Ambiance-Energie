<odoo>
    <record id="amb_studio_inherit_view_company_form" model="ir.ui.view">
        <field name="name">res.company.form.studio</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="after">
              <field name="fax_societe_oci"/>
            </xpath>
            <xpath expr="//field[@name='vat']" position="before">
              <field name="oci_conf_juridique"/>
              <field name="oci_conf_formejurid"/>
            </xpath>
            <xpath expr="//field[@name='siret']" position="after">
              <field name="oci_conf_siren"/>
            </xpath>
            <xpath expr="//field[@name='ape']" position="after">
              <field name="assurance"/>
              <field name="oci_conf_qualibois"/>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="after">
              <field name="oci_conf_rib"/>
              <field name="oci_conf_bic"/>
            </xpath>
            </field>
    </record>

</odoo>