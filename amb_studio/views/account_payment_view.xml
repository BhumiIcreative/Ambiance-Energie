    <record id="amb_studio_account_payment_pivot_view" model="ir.ui.view">
        <field name="name">amb.studio.account.payment.pivot.view</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <pivot string="Payments">
            </pivot>
        </field>
    </record>

    <record id="amb_studio_inherit_view_account_payment_tree" model="ir.ui.view">
        <field name="name">account.payment.tree.inherit.studio</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="before">
                <xpath expr="//field[@name='amount_company_currency_signed']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='payment_method_line_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="oci_point_of_sale"/>
            </xpath>
            <!-- change models of payment_difference   -->
            <!-- <xpath expr="//field[@name='state']" position="after">
              <field name="payment_difference" string="Payment difference" optional="show"/>
            </xpath> -->
            <xpath expr="//field[@name='amount_company_currency_signed']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="amb_studio_inherit_view_account_payment_search">
        <field name="name">amb.studio.inherit.view.account.payment.search</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="oci_point_of_sale"/>
            </xpath>
            <xpath expr="//filter[@name='company']" position="after">
                <filter context="{'group_by': 'oci_point_of_sale'}" name="studio_group_by_lMHv9"
                        string="Point de vente"/>
            </xpath>
            <xpath expr="//filter[@name='activities_upcoming_all']" position="after">
                <separator name="studio_separator_kw0A6"/>
                <filter domain="[['oci_point_of_sale','ilike','Reims']]"
                        name="studio_filter_RqjhA" string="Reims"/>
                <filter domain="[['oci_point_of_sale','ilike','Charleville']]"
                        name="studio_filter_aNfU6" string="Charleville"/>
            </xpath>
        </field>
    </record>

</odoo>