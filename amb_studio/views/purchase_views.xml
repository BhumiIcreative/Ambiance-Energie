<odoo>
    <record id="amb_studio_inherit_purchase_order_tree" model="ir.ui.view">
        <field name="name">amb.studio.inherit.purchase.order.tree</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
    <record id="amb_studio_inherit_purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form.studio</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[1]/field[@name='order_line']/tree[1]/field[@name='product_id']" position="attributes">
              <attribute name="options">{"no_create":true}</attribute>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[1]/field[@name='order_line']/tree[1]/field[@name='name']" position="after">
              <field name="cde_frns_en_cours" invisible="1" force_save="True" readonly="1"/>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[1]/field[@name='order_line']/tree[1]/field[@name='taxes_id']" position="attributes">
              <attribute name="required">not display_type</attribute>
            </xpath>
            <xpath expr="//field[@name='incoterm_id']" position="after">
              <xpath expr="//field[@name='picking_type_id']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='picking_type_id']" position="attributes">
              <attribute name="force_save">True</attribute>
            </xpath>
        </field>
    </record>
</odoo>