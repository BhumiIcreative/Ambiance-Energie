<odoo>
    <!-- Tree View  -->
    <record id="amb_studio_account_full_reconcile_tree_view" model="ir.ui.view">
        <field name="name">amb.studio.account.full.reconcile.tree.view</field>
        <field name="model">account.full.reconcile</field>
        <field name="arch" type="xml">
            <tree string="Full Reconcile">
                <field name="display_name" required='True'/>
                <field name="count_aml" string="count_aml"/>
            </tree>
        </field>
    </record>
    <!-- Form View  -->
    <record id="amb_studio_inherit_view_full_reconcile_form" model="ir.ui.view">
        <field name="name">amb.studio.inherit.view.full.reconcile.form</field>
        <field name="model">account.full.reconcile</field>
        <field name="inherit_id" ref="account.view_full_reconcile_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reconciled_line_ids']" position="after">
                <field name="dernire_ecriture_comptable_id" string="Dernière écriture comptable"
                       options="{&quot;no_create&quot;:true}"/>
            </xpath>
            <xpath expr="//field[@name='reconciled_line_ids']" position="inside">
                <tree string="Journal Items" create="false" expand="context.get('expand', False)" multi_edit="1"
                      js_class="account_move_line_list">
                    <field name="date" optional="show" readonly="1"/>
                    <field name="company_id" options="{'no_create': True}"
                           optional="show"/>
                    <!--                     groups="base.group_multi_company"-->
                    <field name="move_id" optional="show"/>
                    <field name="account_id" optional="show" options="{'no_open': True, 'no_create': True}"
                           domain="[('company_id', '=', company_id)]" groups="account.group_account_user"/>
                    <!--                    <field name="statement_id" invisible="1"/>-->
                    <field name="partner_id" optional="show" readonly="1"/>
                    <field name="ref" optional="hide"/>
                    <field name="name"/>
                    <field name="reconciled" invisible="1"/>
                    <field name="full_reconcile_id" string="Matching" optional="show"/>
                    <field name="reconcile_model_id" invisible="1"/>
                    <field name="date_maturity" optional="hide"/>
                    <field name="debit" sum="Total Debit" readonly="1"/>
                    <field name="credit" sum="Total Credit" readonly="1"/>
                    <field name="amount_currency" readonly="1" groups="base.group_multi_currency"/>

                    <field name="currency_id" readonly="1" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                    <field name="parent_state" invisible="1"/>
                    <groupby name="move_id">
                        <field name="state" invisible="1"/>
                        <button name="edit" type="edit" icon="fa-edit" title="Edit"/>
                        <button name="action_post" states="draft" icon="fa-check" title="Post" type="object"
                                groups="account.group_account_invoice"/>
                        <button name="245" states="posted" title="Reverse" icon="fa-refresh" type="action"
                                groups="account.group_account_invoice"/>
                        <button name="action_duplicate" icon="fa-files-o" title="Duplicate" type="object"
                                groups="account.group_account_invoice"/>
                    </groupby>
                    <field name="move_attachment_ids" invisible="1">
                        <tree>
                            <field name="mimetype"/>
                            <!--  We want to fetch the data for using it in the js-->
                        </tree>
                    </field>
                </tree>
            </xpath>
        </field>
    </record>
    <!--Action -->
    <record id="action_studio_lettrage_complet" model="ir.actions.act_window">
        <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                        This is your new action ; by default, it contains a list view and a form view.
                    </p>
                    <p>
                        You can start customizing these screens by clicking on the Studio icon on the
                        top right corner (you can also customize this help message there).
                    </p>
                ]]></field>
        <field name="name">Lettrage Complet</field>
        <field name="res_model">account.full.reconcile</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>