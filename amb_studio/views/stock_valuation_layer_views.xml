    <record id="amb_studio_inherit_stock_valuation_layer_tree_inherit" model="ir.ui.view">
        <field name="name">amb.studio.inherit.stock.valuation.layer.tree.inherit</field>
        <field name="model">stock.valuation.layer</field>
        <field name="inherit_id" ref="stock_account.stock_valuation_layer_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="unit_cost"/>
            </xpath>
            <xpath expr="//field[@name='value']" position="after">
                <field name="remaining_qty" groups="base.group_no_one"/>
                <field name="remaining_value" groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>
</odoo>