<odoo>
    <record id="amb_studio_oci_provenance_contact_form" model="ir.ui.view">
        <field name="name">oci.provenance.contact.form.studio</field>
        <field name="model">oci.provenance.contact</field>
        <field name="arch" type="xml">
            <form>
                <sheet string="OCI Origin Contact">
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="amb_studio_oci_provenance_contact_tree" model="ir.ui.view">
        <field name="name">oci.provenance.contact.tree.studio</field>
        <field name="model">oci.provenance.contact</field>
        <field name="arch" type="xml">
            <tree string="OCI_provenance_contact">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <!-- Action -->
    <record id="action_studio_provenance" model="ir.actions.act_window">
        <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                        This is your new action ; by default, it contains a list view and a form view.
                    </p>
                    <p>
                        You can start customizing these screens by clicking on the Studio icon on the
                        top right corner (you can also customize this help message there).
                    </p>
                ]]></field>
        <field name="name">Provenance</field>
        <field name="res_model">oci.provenance.contact</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>