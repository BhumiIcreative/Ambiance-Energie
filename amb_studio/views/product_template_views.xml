<odoo>
    <!-- Tree View -->
    <record id="amb_studio_inherit_product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.tree.studio</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_id']" position="replace">
                <field name="sales_count" string="Sold"/>
                <field name="outgoing_qty"/>
                <field name="incoming_qty"/>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="rf_fournisseur"/>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="dernier_prix_dachat_fournisseur"/>
            </xpath>
    <!-- move to amb_stock            -->
<!--            <xpath expr="//field[@name='standard_price']" position="after">-->
<!--                <field name="free_qty"/>-->
<!--            </xpath>-->
            <xpath expr="//field[@name='activity_exception_decoration']" position="after">
                <field name="reordering_min_qty"/>
                <field name="reordering_max_qty"/>
            </xpath>
        </field>
    </record>
    <!-- Pivot View -->
    <record id="product_template_pivot_view" model="ir.ui.view">
        <field name="name">product.template.product.pivot</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <pivot string="Product Template"/>
        </field>
    </record>


    <!-- Search View -->
    <record id="amb_studio_inherit_mrp_product_template_search_view" model="ir.ui.view">
        <field name="name">amb.studio.inherit.mrp.product.template.search.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="mrp.mrp_product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attribute_line_ids']" position="after">
                <field name="seller_ids"/>
                <field name="rf_fournisseur"/>
                <field name="default_code"/>
            </xpath>
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator name="studio_separator_we9K7"/>
                <filter domain="[['virtual_available','&lt;',0]]" name="studio_filter_wnhSA"
                        string="Quantité prévue négative"/>
                <filter domain="[['virtual_available','&lt;',5]]" name="studio_filter_KNhmE"
                        string="Qté prévue inférieur à 5"/>
                <separator name="studio_separator_MvKDw"/>
                <filter domain="[['outgoing_qty','&gt;',0]]" name="studio_filter_pA8mt" string="Articles à livrer"/>
            </xpath>
<!-- move to amb_sale            -->
<!--            <xpath expr="//search[1]/group[1]/filter[@name='categ_id']" position="after">-->
<!--                <filter context="{'group_by': 'supplier_id'}" name="studio_group_by_JOdjG" string="Fournisseur"/>-->
<!--            </xpath>-->
        </field>
    </record>
    <!-- Form View -->
    <record id="amb_studio_inherit_product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.form.studio</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="non_remisable_1" groups="account.group_account_manager"/>
                <field name="non_remisable_1" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='taxes_id']" position="after">
                <field name="frais_approche_article"/>
                <field name="dernier_prix_dachat_fournisseur" widget="monetary"/>
            </xpath>
            <xpath expr="//form[@name='Product Template']/sheet[1]/notebook[1]/page[@name='general_information']/group[1]/group[@name='group_standard_price']/field[@name='company_id']"
                   position="attributes">
                <attribute name="required">id != 20281 and name != 'Prime CEE EDF'</attribute>
            </xpath>
            <xpath expr="//field[@name='seller_ids']" position="inside">
                <tree string="Supplier Information" multi_edit="1">
                    <field name="sequence" widget="handle" readonly="1"/>
                    <field name="partner_id" readonly="1"/>
                    <field name="product_id" readonly="1" optional="hide"
                           invisible="context.get('product_template_invisible_variant', False)"
                           groups="product.group_product_variant"/>
<!--                    <field name="product_tmpl_id" string="Article" readonly="1"-->
<!--                           invisible="context.get('visible_product_tmpl_id', True)"/>-->
                    <field name="currency_id" groups="base.group_multi_currency"/>
                    <field name="date_start" optional="hide"/>
                    <field name="date_end" optional="hide"/>
                    <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                    <field name="product_code"/>
                    <field name="min_qty"/>
                    <field name="product_uom" groups="uom.group_uom"/>
                    <field name="price"/>
                </tree>
            </xpath>
            <xpath expr="//form[@name='Product Template']/sheet[1]/notebook[1]" position="inside">
                <page string="Current orders">
                    <group>
                        <group>
                            <field name="field_jPwOa_ids">
                                <tree decoration-muted="state == 'cancel'"
                                      default_order="date_deadline, picking_id, sequence" string="Moves" create="0">
                                    <field name="date_deadline" widget="date" readonly="state in ['done']"
                                           column_invisible="1"/>
                                    <field name="date" string="Creation date" widget="date" optional="hide"/>
                                    <field name="picking_id" string="Reference" column_invisible="1"/>
                                    <field name="sequence" column_invisible="1"/>
<!--&lt;!&ndash;                                    <field name="point_de_vente_2"/>&ndash;&gt; in stock move-->
                                    <field name="origin" optional="show"/>
<!--&lt;!&ndash;                                    <field name="client"/>&ndash;&gt; same-->
                                    <field name="product_id" readonly="state in ['done']" column_invisible="1"/>
                                    <field name="product_uom_qty" string="Order in progress"
                                           sum="Sum of Initial Request"/>
                                    <field name="product_uom" options="{'no_open': True, 'no_create': True}"
                                           string="Unit of measurement" groups="uom.group_uom"
                                           column_invisible="1"/>
                                    <field name="location_id" options="{'no_create': True}" column_invisible="1"/>
                                    <field name="location_dest_id" column_invisible="1"/>
                                    <field name="create_date" column_invisible="1"/>
                                    <field name="state" optional="show" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                </tree>
                                <form string="Stock Moves" create="0" edit="0">
                                    <header>
                                        <field name="state" widget="statusbar"
                                               statusbar_visible="draft,confirmed,assigned,done"/>
                                    </header>
                                    <sheet>
                                        <div class="oe_button_box" name="button_box">
                                            <button name="action_get_account_moves" icon="fa-usd" class="oe_stat_button"
                                                    string="Accounting Entries" type="object"
                                                    groups="account.group_account_user"/>
                                        </div>
                                        <group>
                                            <group colspan="2">
                                                <group>
                                                    <field name="reference"/>
                                                    <field name="location_id" options="{'no_create': True}"/>
                                                    <field name="location_dest_id" options="{'no_create': True}"/>
                                                    <field name="company_id" groups="base.group_multi_company"/>
                                                </group>
                                                <group>
                                                    <field name="product_id"/>
                                                    <field name="product_uom_category_id" invisible="1"/>
                                                    <label for="product_uom_qty"/>
                                                    <div class="o_row">
                                                        <field name="product_uom_qty"/>
                                                        <field name="product_uom"
                                                               options="{'no_open': True, 'no_create': True}"
                                                               groups="uom.group_uom"/>
                                                    </div>
                                                    <field name="name" invisible="1"/>
                                                    <field name="date_deadline"/>
                                                    <field name="date" invisible="state != 'done'"/>
                                                </group>
                                            </group>
                                            <group name="origin_grp" string="Origin" groups="base.group_no_one">
                                                <field name="origin"/>
                                                <field name="group_id"/>
                                                <field name="procure_method" readonly="state != 'draft'"
                                                       groups="stock.group_adv_location"/>
                                                <field name="purchase_line_id"/>
                                            </group>
                                            <group name="linked_group" string="Linked Moves" groups="base.group_no_one"
                                                   colspan="2">
                                                <field name="move_orig_ids" string="Origin Moves" readonly="1">
                                                    <tree>
                                                        <field name="location_id"/>
                                                        <field name="location_dest_id"/>
                                                        <field name="product_uom_qty"/>
                                                        <field name="product_uom"/>
                                                        <field name="state"/>
                                                    </tree>
                                                </field>
                                                <field name="move_dest_ids" string="Destination Moves" readonly="1">
                                                    <tree>
                                                        <field name="location_id"/>
                                                        <field name="location_dest_id"/>
                                                        <field name="product_uom_qty"/>
                                                        <field name="product_uom"/>
                                                        <field name="state"/>
                                                    </tree>
                                                </field>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <!-- Search View -->
    <record id="amb_studio_inherit_product_template_search_form_view_stock" model="ir.ui.view">
        <field name="name">product.template.search.form.view.studio</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_search_form_view_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//search[1]/separator[5]" position="replace">
                <field name="rf_fournisseur"/>
                <field name="seller_ids"/>
                <separator/>
                <filter domain="[('bom_ids', 'ilike', 'Kit')]" name="studio_filter_9P5xM" string="Kit"/>
            </xpath>
            <xpath expr="//search[1]/field[@name='name']" position="before">
                <field name="default_code"/>
            </xpath>
<!--            amb_stock-->
<!--            <xpath expr="//search[1]/group[1]/filter[@name='categ_id']" position="after">-->
<!--                <filter context="{'group_by': 'supplier_id'}" name="studio_group_by_X27dP" string="Supplier"/>-->
<!--            </xpath>-->
        </field>
    </record>


    <!--Action -->
    <record id="stock.product_template_action_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>
    <record id="action_studio_article" model="ir.actions.act_window">
        <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                        This is your new action ; by default, it contains a list view and a form view.
                    </p>
                    <p>
                        You can start customizing these screens by clicking on the Studio icon on the
                        top right corner (you can also customize this help message there).
                    </p>
                ]]></field>
        <field name="name">Article</field>
        <field name="res_model">product.template</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,kanban,form,activity</field>
    </record>
    <record id="action_studio_articles2" model="ir.actions.act_window">
        <field name="context">{'search_default_uom_id': active_id,'default_uom_id': active_id}</field>
        <field name="domain">[('uom_id', '=', active_id)]</field>
        <field name="name">Articles</field>
        <field name="res_model">product.template</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>