<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_tax_tree_studio" model="ir.ui.view">
            <field name="name">account.tax.tree.studio</field>
            <field name="model">account.tax</field>
            <field name="inherit_id" ref="account.view_tax_tree" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='description']" position="after">
                  <field name="cash_basis_transition_account_id"/>
                </xpath>
            </field>
        </record>
        <record id="view_account_tax_search_studio" model="ir.ui.view">
            <field name="name">account.tax.search.studio</field>
            <field name="model">account.tax</field>
            <field name="inherit_id" ref="account.view_account_tax_search" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='company_id']" position="after">
                  <field name="amount" string="Taux"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>