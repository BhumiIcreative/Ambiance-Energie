<odoo>
    <!-- Sale order  -->
    <!-- Tree View   -->
    <record id="amb_studio_inherit_view_order_tree" model="ir.ui.view">
        <field name="name">amb.studio.inherit.view.order.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <!--            <xpath expr="//field[@name='commitment_date']" position="replace">-->
            <!--                <field name="oci_saleorder_yourref"/>-->
            <!--            </xpath>-->
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="no_invoiced" string="Non facturé" optional="show" sum="Sum of Non facturé"/>
            </xpath>
        </field>
    </record>
    <!-- Form View  -->
    <record id="amb_studio_inherit_view_order_form" model="ir.ui.view">
        <field name="name">view.order.form.studio</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!--            <xpath expr="//field[@name='partner_id']" position="after">-->
            <!--                <field name="oci_point_of_sale"/>-->
            <!--            </xpath>-->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="modle_de_poele" invisible="not modle_de_poele"/>
                <field name="adresse" invisible="id"/>
                <!--                <xpath expr="//field[@name='oci_point_of_sale']" position="move"/>-->
            </xpath>
            <!--            <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/field[@name='client_situation']" position="after">-->
            <!--                <field name="oci_saleorder_refcustomer"/>-->
            <!--            </xpath>-->
            <!--            <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/field[@name='client_situation'][3]" position="after">-->
            <!--                <field name="pos_vendeur_id" invisible="1"/>-->
            <!--            </xpath>-->
            <!--            in other module-->
            <!--            <xpath expr="//field[@name='validity_date']" position="after">-->
            <!--                <field name="type_order" invisible="1"/>-->
            <!--                <field name="oci_saleorder_technicien_id" domain="[('active', '=', True)]"-->
            <!--                       required="type_order == 'serv'"/>-->
            <!--            </xpath>-->
            <!--            <xpath expr="//form[1]/sheet[1]/group[1]/group[2]/field[@name='payment_instrument_id']" position="after">-->
            <!--                <field name="campaign_id"/>-->
            <!--            </xpath>-->
            <!--            <xpath expr="//field[@name='sponsorship']" position="after">-->
            <!--                <field name="oci_saleorder_yourref"/>-->
            <!--            </xpath>-->
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='order_lines']/field[@name='order_line']/tree[1]/field[@name='sequence']"
                   position="after">
                <field name="non_remisable"/>
                <field name="commande_en_cours" force_save="True" readonly="1" invisible="1"/>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='order_lines']/field[@name='order_line']/tree[1]/field[@name='tax_id']"
                   position="attributes">
                <attribute name="readonly">qty_invoiced &gt; 0</attribute>
                <attribute name="required">not display_type</attribute>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='order_lines']/field[@name='order_line']/tree[1]/field[@name='discount']"
                   position="attributes">
                <attribute name="readonly">non_remisable</attribute>
            </xpath>
            <!--            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='margin_lines']/field[@name='margin_order_line']/tree[1]/field[@name='price_subtotal']"-->
            <!--                   position="attributes">-->
            <!--                <attribute name="sum">Sum of Sous-total</attribute>-->
            <!--            </xpath>-->
            <!--            <xpath expr="//field[@name='team_id']" position="attributes">-->
            <!--                <attribute name="attrs">{}</attribute>-->
            <!--            </xpath>-->
            <xpath expr="//field[@name='client_order_ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!--            <xpath expr="//field[@name='oci_point_of_sale']" position="attributes">-->
            <!--                <attribute name="required">not pos_vendeur_id</attribute>-->
            <!--                <attribute name="domain">[["pos_archive","=",False]]</attribute>-->
            <!--                <attribute name="options">{"no_create":true,"no_open":true}</attribute>-->
            <!--            </xpath>-->
        </field>
    </record>
    <!-- Quotation Tree View -->
    <record id="amb_studio_inherit_view_quotation_tree_with_onboarding" model="ir.ui.view">
        <field name="name">view.quotation.tree.with.onboarding.studio</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
    <!-- Action -->
    <record id="action_studio_bon_de_commande" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="domain">[('state', 'not in', ('draft', 'sent', 'cancel'))]</field>
        <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                    Créez un nouveau devis, la première étape d'une vente!
                </p><p>
                    Une fois le devis confirmé, il devient une commande de vente. <br> Vous pourrez créer une facture et collecter le paiement.
                </p>
            ]]></field>
        <field name="name">Bon de commande</field>
        <field name="res_model">sale.order</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field>
    </record>
    <record id="action_studio_commandes_a_facturer" model="ir.actions.act_window">
        <field name="context">{'create': False}</field>
        <field name="domain">[('invoice_status','=','to invoice')]</field>
        <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                Pas de commandes à facturer trouvées
              </p><p>
                Vous pouvez sélectionner toutes les commandes et les facturer en groupe,<br>
ou vérifiez chaque commande et les facturer une par une.
              </p>]]></field>
        <field name="name">Commandes à facturer</field>
        <field name="res_model">sale.order</field>
        <field name="search_view_id" ref="sale.view_sales_order_filter"/>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form,calendar,graph,pivot,kanban,activity</field>
    </record>
    <record id="action_studio_devis_" model="ir.actions.act_window">
        <field name="context">{'search_default_my_quotation': 1}</field>
        <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                Créez un nouveau devis, la première étape d'une vente!
              </p><p>
                Une fois le devis confirmé par le client, il devient une commande de vente. <br>Vous pourrez créer une facture et collecter le paiement.
              </p>]]></field>
        <field name="name">Devis</field>
        <field name="res_model">sale.order</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field>
    </record>
    <record id="action_studio_clients_" model="ir.actions.act_window">
        <field name="context">{'search_default_customer': 1,'res_partner_search_mode': 'customer', 'default_is_company': True, 'default_customer_rank': 1}</field>
        <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                Créer un nouveau client dans votre carnet d'adresse
              </p><p>
                Odoo vous aide à facilement suivre toutes les activités liées à un vendeur.
              </p>]]></field>
        <field name="name">Clients</field>
        <field name="res_model">res.partner</field>
        <field name="search_view_id" eval="False"/>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="base.view_partner_tree"/>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <!-- Sale Subscription     -->
    <!-- Form View    -->
    <record id="amb_studio_inherit_sale_subscription_primary_form_view" model='ir.ui.view'>
        <field name='name'>amb.studio.inherit.sale.subscription.primary.form.view</field>
        <field name='model'>sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_primary_form_view"/>
        <field name='arch' type='xml'>
            <xpath expr="//field[@name='sale_order_template_id']" position="after">
                <field name="oci_abo_date_prochaine_intervention" string="Date prochaine intervention"/>
            </xpath>
        </field>
    </record>
    <!-- Search View    -->
    <record id="amb_studio_inherit_sale_subscription_view_search" model='ir.ui.view'>
        <field name='name'>amb.studio.inherit.sale.subscription.view.search</field>
        <field name='model'>sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_view_search"/>
        <field name='arch' type='xml'>
            <xpath expr="//filter[@name='end_month']" position="after">
                <filter context="{'group_by': 'oci_abo_date_prochaine_intervention'}"
                        name="studio_group_by_PPYMh" string="Date prochaine intervention"/>
            </xpath>
        </field>
    </record>
    <!-- Tree View    -->
    <record id="amb_studio_inherit_sale_subscription_view_tree" model="ir.ui.view">
        <field name="name">amb.studio.inherit.sale.subscription.view.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="oci_abo_date_prochaine_intervention"/>
            </xpath>
            <!--            Need to move-->
            <!--            <xpath expr="//field[@name='user_id']" position="after">-->
            <!--                <field name="oci_point_of_sale"/>-->
            <!--            </xpath>-->
            <!--            not v17-->
            <!--            <xpath expr="//field[@name='company_id']" position="after">-->
            <!--                <field name="recurring_amount_total"/>-->
            <!--            </xpath>-->
        </field>
    </record>
</odoo>