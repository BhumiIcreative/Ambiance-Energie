<odoo>

<template id="mrp_cost_structure" inherit_id="mrp_account_enterprise.mrp_cost_structure">
    <xpath expr="//t[@t-call='web.basic_layout']" position="replace">
    <t t-call="web.basic_layout">
          <t t-call-assets="mrp_account_enterprise.assets_mrp_cost_structure_report" t-js="False"/>
          <div class="page o_mrp_report_page">
            <t t-if="not lines">
              <span class="text-center o_mrp_report_info">
                <h1>Un ou plusieurs ordres de fabrication sélectionnés ne sont pas encore terminé.</h1>
              </span>
            </t>
            <t t-else="">
              <span class="text-left">
                <h1 class="o_mrp_header o_mrp_header1">Analyse des coûts</h1>
              </span>
            </t>
            <t t-foreach="lines" t-as="line">
              <t t-set="currency" t-value="line['currency']"/>
              <t t-set="opcost" t-value="0.0"/>
              <t t-set="tot_scrap_cost" t-value="0.0"/>
              <!-- Title -->
              <strong class="o_mrp_report_info"><strong t-esc="line['product'].name"/>, <t t-esc="line['mo_qty']"/><t t-esc="line['mo_uom'].name"/>, de <t t-esc="line['mocount']"/> ordre(s) de fabrications.
                    </strong>
              <t t-if="line['byproduct_moves']">
                <h3 class="o_mrp_header">Par produit(s)</h3>
              </t>
              <div t-foreach="line['byproduct_moves']" t-as="sub">
                <t t-esc="sub.product_id.name"/>
                <t t-esc="sub.product_uom_qty"/>
                <t t-esc="sub.product_uom.name"/>
              </div>
              <!-- Cost Structure table -->
              <h3 class="o_mrp_header o_mrp_table_header">Structure de coût</h3>
              <table class="table table-sm o_mrp_report_table">
                <thead>
                  <tr class="o_mrp_report_header">
                    <th class="o_mrp_report_line_header">
                      <span>Code</span>
                    </th>
                    <th class="o_mrp_report_line_header">
                      <span>Composants</span>
                    </th>
                    <th class="text-right o_mrp_report_line_header">
                      <span>Quantité</span>
                    </th>
                    <th class="text-right o_mrp_report_line_header">
                      <span>Coût Unitaire</span>
                    </th>
                    <th class="text-right o_mrp_report_line_header">
                      <span>Coût Total</span>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr t-foreach="line['raw_material_moves']" t-as="m" class="o_mrp_data">
                    <td>
                      <span t-esc="m['product_id'].default_code or ''"/>
                    </td>
                    <td>
                      <span class="o_mrp_reports_web_action" t-att-res-id="m['product_id'].id" res-model="mrp.bom.line" view-type="form" t-esc="m['product_id'].display_name"/>
                    </td>
                    <td class="text-right">
                      <span t-esc="m['qty']" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;decimal_precision&quot;: &quot;Product Unit of Measure&quot;}"/>
                      <span t-esc="m['product_id'].uom_id.name"/>
                    </td>
                    <td class="text-right">
                      <span t-esc="m['cost'] / m['qty'] if m['qty'] else m['cost']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}"/>
                    </td>
                    <td class="text-right">
                      <span t-esc="m['cost']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}"/>
                    </td>
                  </tr>
                  <tr>
                    <td colspan="4" class="text-right">
                      <strong>Coût total des composants</strong>
                    </td>
                    <td class="text-right">
                      <strong t-esc="line['total_cost']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}"/>
                    </td>
                  </tr>
                </tbody>
              </table>
              <!-- Cost of Operations table -->
              <t t-if="line['operations']">
                <h3 class="o_mrp_header o_mrp_table_header">Coût des opérations</h3>
                <table class="table table-sm o_mrp_report_table">
                  <thead>
                    <tr class="o_mrp_report_header">
                      <th class="o_mrp_report_line_header">
                        <span>Opérateur</span>
                      </th>
                      <th class="o_mrp_report_line_header">
                        <span>Opération</span>
                      </th>
                      <th class="text-right o_mrp_report_line_header">
                        <span>Temps de Travail</span>
                      </th>
                      <th class="text-right o_mrp_report_line_header">
                        <span>Coût/heure</span>
                      </th>
                      <th class="text-right o_mrp_report_line_header">
                        <span>Coût Total</span>
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr t-foreach="line['operations']" t-as="row" class="o_mrp_data">
                      <td>
                        <span t-esc="row[0]"/>
                      </td>
                      <td>
                        <span class="o_mrp_reports_web_action" t-att-res-id="row[1]" res-model="mrp.routing.workcenter" view-type="form" t-esc="row[2]"/>
                      </td>
                      <td class="text-right">
                        <span><t t-esc="row[3]" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 4}"/> heures</span>
                      </td>
                      <td class="text-right">
                        <span t-esc="row[4]"/>
                      </td>
                      <td class="text-right">
                        <span t-esc="row[3] * row[4]" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}"/>
                      </td>
                      <t t-set="opcost" t-value="opcost + row[3] * row[4]"/>
                    </tr>
                    <tr>
                      <td colspan="4" class="text-right">
                        <strong>Coût total de fonctionnement</strong>
                      </td>
                      <td class="text-right">
                        <span t-esc="opcost" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}"/>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </t>
              <!-- Cost of Scraps table -->
              <t t-if="line['scraps']">
                <h3 class="o_mrp_header o_mrp_table_header">Coût des rebuts</h3>
                <table class="table table-sm o_mrp_report_table">
                  <thead>
                    <tr class="o_mrp_report_header">
                      <th class="o_mrp_report_line_header">
                        <span>Rebuts</span>
                      </th>
                      <th class="text-right o_mrp_report_line_header">
                        <span>Quantité</span>
                      </th>
                      <th class="text-right o_mrp_report_line_header">
                        <span>Coût Unitaire</span>
                      </th>
                      <th class="text-right o_mrp_report_line_header">
                        <span>Coût Total</span>
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr t-foreach="line['scraps']" t-as="scrap" class="o_mrp_data">
                      <td>
                        <span class="o_mrp_reports_web_action" t-att-res-id="scrap.id" res-model="stock.move" view-type="form" t-esc="scrap.product_id.display_name"/>
                      </td>
                      <td class="text-right">
                        <span>
                          <t t-esc="scrap.product_uom_qty"/>
                          <t t-esc="scrap.product_uom.name"/>
                        </span>
                      </td>
                      <td class="text-right">
                        <span t-esc="scrap.stock_valuation_layer_ids.unit_cost" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}"/>
                      </td>
                      <td class="text-right">
                        <span t-esc="scrap.product_uom_qty * scrap.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}"/>
                      </td>
                      <t t-set="tot_scrap_cost" t-value="tot_scrap_cost + (scrap.product_uom_qty * scrap.stock_valuation_layer_ids.unit_cost)"/>
                    </tr>
                    <tr>
                      <td colspan="3" class="text-right">
                        <strong/>
                      </td>
                      <td class="text-right">
                        <span t-esc="tot_scrap_cost" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}"/>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </t>
              <!-- Cost table -->
              <div class="row">
                <div class="col-6 offset-6">
                  <table class="table table-sm o_mrp_report_table">
                    <tr t-if="line['mo_qty'] &gt; 1">
                      <td class="text-right">
                        <strong>Coût pour <t t-esc="line['mo_qty']"/> <t t-esc="line['mo_uom'].name"/></strong>
                      </td>
                      <td class="text-right">
                        <strong t-esc="line['total_cost'] + opcost" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}"/>
                      </td>
                    </tr>
                    <tr>
                      <td class="text-right">
                        <strong>Coût unitaire</strong>
                      </td>
                      <th class="text-right">
                        <strong t-esc="(line['total_cost'] + opcost) / line['mo_qty']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}"/>
                      </th>
                    </tr>
                  </table>
                </div>
              </div>
            </t>
          </div>
        </t>  

    </xpath>
</template>
</odoo>
