<odoo noupdate="1">
    <record id="custom_invoice_report_format" model="report.paperformat">
        <field name="name">Invoice report format</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">80.0</field>
        <field name="margin_bottom">23.0</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">75</field>
        <field name="dpi">90</field>
        <field name="print_page_height">297.0</field>
        <field name="print_page_width">210.0</field>
    </record>
</odoo>
